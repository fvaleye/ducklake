# name: test/sql/functions/ducklake_data_changes_maintenance.test
# description: Maintenance commits record an empty logical data change
# group: [functions]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# Maintenance never records a logical data change: flushes, compaction and DDL all write an empty entry

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/data_changes_maintenance', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t(a INT)

# the flush of inlined inserts

statement ok
INSERT INTO dl.t SELECT i FROM range(5) r(i)

statement ok
CALL ducklake_flush_inlined_data('dl')

# the flush of an inlined delete of Parquet rows is recorded as deleted_from_table in changes, but deletes no row

statement ok
INSERT INTO dl.t SELECT i FROM range(100, 200) r(i)

statement ok
DELETE FROM dl.t WHERE a = 150

statement ok
CALL ducklake_flush_inlined_data('dl')

# compaction

statement ok
INSERT INTO dl.t SELECT i FROM range(200, 300) r(i)

statement ok
CALL ducklake_merge_adjacent_files('dl')

statement ok
DELETE FROM dl.t WHERE a BETWEEN 100 AND 180

statement ok
CALL ducklake_rewrite_data_files('dl', delete_threshold => 0.0)

# DDL

statement ok
ALTER TABLE dl.t ADD COLUMN b INT

query ITT
SELECT snapshot_id, changes, data_changes FROM dl.snapshots() WHERE snapshot_id >= 2 ORDER BY snapshot_id
----
2	{inlined_insert=[1]}	{tables_inserted_into=[1]}
3	{flushed_inlined=[1]}	{}
4	{tables_inserted_into=[1]}	{tables_inserted_into=[1]}
5	{inlined_delete=[1]}	{tables_deleted_from=[1]}
6	{tables_deleted_from=[1]}	{}
7	{tables_inserted_into=[1]}	{tables_inserted_into=[1]}
8	{merge_adjacent=[1]}	{}
9	{tables_deleted_from=[1]}	{tables_deleted_from=[1]}
10	{rewrite_delete=[1]}	{}
11	{tables_altered=[1]}	{}

query I
SELECT count(*) FROM dl.t
----
124
