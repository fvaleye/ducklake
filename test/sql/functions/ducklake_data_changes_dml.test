# name: test/sql/functions/ducklake_data_changes_dml.test
# description: data_changes of MERGE, CTAS, TRUNCATE, whole-file drops and ducklake_add_data_files
# group: [functions]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/ducklake_data_changes_dml_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.m(a INT)

statement ok
INSERT INTO dl.m SELECT range FROM range(50)

statement ok
MERGE INTO dl.m USING (SELECT * FROM (VALUES (1), (1000)) s(id)) s ON m.a = s.id WHEN MATCHED THEN DELETE WHEN NOT MATCHED THEN INSERT VALUES (s.id)

statement ok
MERGE INTO dl.m USING (SELECT 2 AS id) s ON m.a = s.id WHEN MATCHED THEN DELETE

statement ok
CREATE TABLE dl.ctas_file AS SELECT range AS a FROM range(50)

statement ok
CREATE TABLE dl.ctas_inlined AS SELECT 1 AS a

statement ok
CREATE TABLE dl.ctas_empty AS SELECT 1 AS a WHERE false

statement ok
CREATE TABLE dl.added(a BIGINT)

statement ok
COPY (SELECT range::BIGINT AS a FROM range(20)) TO '{DATA_PATH}/data_changes_added.parquet'

statement ok
CALL ducklake_add_data_files('dl', 'added', '{DATA_PATH}/data_changes_added.parquet')

statement ok
TRUNCATE dl.m

statement ok
CREATE TABLE dl.alt(a INT)

statement ok
ALTER TABLE dl.alt ADD COLUMN b INT

statement ok
INSERT INTO dl.alt SELECT range, range FROM range(50)

statement ok
UPDATE dl.alt SET a = a WHERE a = 5

statement ok
CREATE TABLE dl.w AS SELECT range AS a FROM range(50)

statement ok
DELETE FROM dl.w

statement ok
DROP TABLE dl.alt

# MERGE, TRUNCATE, a whole-file drop and CTAS (with its final table id) record what they change,
# and UPDATE SET a = a records both. DROP TABLE is a catalog change only
query III
SELECT snapshot_id, changes_made, data_changes FROM meta.ducklake_snapshot_changes ORDER BY ALL
----
0	created_schema:"main"	(empty)
1	created_table:"main"."m"	(empty)
2	inserted_into_table:1	inserted_into_table:1
3	inlined_insert:1,inlined_delete:1	inserted_into_table:1,deleted_from_table:1
4	inlined_delete:1	deleted_from_table:1
5	created_table:"main"."ctas_file",inserted_into_table:2	inserted_into_table:2
6	created_table:"main"."ctas_inlined",inlined_insert:3	inserted_into_table:3
7	created_table:"main"."ctas_empty"	(empty)
8	created_table:"main"."added"	(empty)
9	inserted_into_table:5	inserted_into_table:5
10	deleted_from_table:1,inlined_delete:1	deleted_from_table:1
11	created_table:"main"."alt"	(empty)
12	altered_table:6	(empty)
13	inserted_into_table:6	inserted_into_table:6
14	inlined_insert:6,inlined_delete:6	inserted_into_table:6,deleted_from_table:6
15	created_table:"main"."w",inserted_into_table:7	inserted_into_table:7
16	deleted_from_table:7	deleted_from_table:7
17	dropped_table:6	(empty)

# every data_changes entry is a changes_made entry, with inlined_* read as inserted_into_table and deleted_from_table
query I
SELECT count(*)
FROM meta.ducklake_snapshot_changes
WHERE len(list_filter(string_split(data_changes, ','),
          lambda e: e <> '' AND NOT list_contains(string_split(replace(replace(changes_made, 'inlined_insert', 'inserted_into_table'), 'inlined_delete', 'deleted_from_table'), ','), e))) > 0
----
0
