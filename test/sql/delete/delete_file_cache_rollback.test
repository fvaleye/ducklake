# name: test/sql/delete/delete_file_cache_rollback.test
# description: Cached delete replacements remain isolated across rollback
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/delete_file_cache_rollback', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t AS SELECT i FROM range(100) t(i)

statement ok
DELETE FROM lake.t WHERE i < 10

query I con1
SELECT sum(i) FROM lake.t
----
4905

statement ok con2
BEGIN

query I con2
SELECT sum(i) FROM lake.t
----
4905

statement ok con1
BEGIN

statement ok con1
DELETE FROM lake.t WHERE i >= 90

query I con1
SELECT sum(i) FROM lake.t
----
3960

query I con2
SELECT sum(i) FROM lake.t
----
4905

query I con1
SELECT sum(i) FROM lake.t
----
3960

statement ok con1
ROLLBACK

query I con1
SELECT sum(i) FROM lake.t
----
4905

query I con2
SELECT sum(i) FROM lake.t
----
4905

statement ok con2
COMMIT
