# name: test/sql/delete/delete_using_disordered_matches.test
# description: DELETE USING handles disordered duplicate matches across chunks
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/delete_using_disordered_matches', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t AS SELECT range AS id FROM range(4096)

statement ok
BEGIN

query I
DELETE FROM ducklake.t USING (
    SELECT i % 2048 * 2 AS id FROM range(8192) t(i) ORDER BY hash(i)
) d WHERE t.id = d.id
----
2048

query II
SELECT count(*), sum(id) FROM ducklake.t
----
2048	4194304

statement ok
ROLLBACK

query II
SELECT count(*), sum(id) FROM ducklake.t
----
4096	8386560
