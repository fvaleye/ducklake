# name: test/sql/delete/delete_file_cache.test
# description: Scans read a delete file once and merge inlined deletes into a copy of its rows
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/delete_file_cache', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t AS SELECT i FROM range(100) t(i);

statement ok
DELETE FROM ducklake.t WHERE i < 10;

query I
SELECT sum(i) FROM ducklake.t;
----
4905

statement ok
CALL enable_logging('FileSystem')

query I
SELECT sum(i) FROM ducklake.t;
----
4905

query I
SELECT count(*) FROM duckdb_logs_parsed('FileSystem') WHERE path LIKE '%-delete.%' AND op = 'OPEN';
----
0

statement ok
CALL ducklake.set_option('data_inlining_row_limit', 100);

statement ok
DELETE FROM ducklake.t WHERE i = 50;

query I
SELECT sum(i) FROM ducklake.t;
----
4855

query I
SELECT sum(i) FROM ducklake.t AT (VERSION => 2);
----
4905

statement ok
CALL ducklake.set_option('data_inlining_row_limit', 0);

statement ok
DELETE FROM ducklake.t WHERE i >= 90;

query I
SELECT sum(i) FROM ducklake.t;
----
3910
