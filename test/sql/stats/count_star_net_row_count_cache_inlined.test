# name: test/sql/stats/count_star_net_row_count_cache_inlined.test
# description: An inlined delete changes the exact count without allocating a data file
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/count_star_net_row_count_cache_inlined', DATA_INLINING_ROW_LIMIT 100)

statement ok
CREATE TABLE ducklake.t AS SELECT range::BIGINT AS i FROM range(10);

query I
SELECT COUNT(*) FROM ducklake.t;
----
10

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 't');
----
0

statement ok
DELETE FROM ducklake.t WHERE i < 3;

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory', storage_buffer_size => 0)

query I
SELECT COUNT(*) FROM ducklake.t;
----
7

query I
SELECT COUNT(*) FROM ducklake.t;
----
7

query I
SELECT COUNT(*)
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%SUM(record_count)%'
  AND query LIKE '%ducklake_data_file%'
  AND query LIKE '%ducklake_delete_file%';
----
1
