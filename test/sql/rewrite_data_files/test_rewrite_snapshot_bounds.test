# name: test/sql/rewrite_data_files/test_rewrite_snapshot_bounds.test
# description: Rewriting several files and tables keeps their snapshot bounds and time travel
# group: [rewrite_data_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/rewrite_batched_metadata', METADATA_CATALOG 'rewrite_meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
SET threads = 1

statement ok
CREATE TABLE dl.a(id BIGINT)

statement ok
CREATE TABLE dl.b(id BIGINT)

loop part 0 4

statement ok
INSERT INTO dl.a SELECT range + {part} * 100 FROM range(100)

statement ok
INSERT INTO dl.b SELECT range + {part} * 100 FROM range(100)

endloop

statement ok
SET VARIABLE before_delete = (SELECT max(snapshot_id) FROM ducklake_snapshots('dl'))

statement ok
DELETE FROM dl.a WHERE id % 2 = 0

statement ok
DELETE FROM dl.b WHERE id % 2 = 0

statement ok
CREATE TEMP TABLE rewrite_sources AS SELECT data_file_id FROM rewrite_meta.ducklake_data_file WHERE end_snapshot IS NULL

statement ok
BEGIN

statement ok
CALL ducklake_rewrite_data_files('dl', delete_threshold => 0)

statement ok
ROLLBACK

query IIII
SELECT count(*), min(id), max(id), sum(id) FROM dl.a
----
200	1	399	40000

statement ok
BEGIN

statement ok
CALL ducklake_rewrite_data_files('dl', delete_threshold => 0)

# a repeated rewrite in the same transaction must not rewrite its earlier inputs again
statement ok
CALL ducklake_rewrite_data_files('dl', delete_threshold => 0)

statement ok
COMMIT

statement ok
SET VARIABLE rewrite_snapshot = (SELECT max(snapshot_id) FROM ducklake_snapshots('dl'))

query IIII
SELECT count(*), min(id), max(id), sum(id) FROM dl.b
----
200	1	399	40000

query II
SELECT count(*), bool_and(end_snapshot = getvariable('rewrite_snapshot')) FROM rewrite_meta.ducklake_data_file JOIN rewrite_sources USING (data_file_id)
----
8	true

query II
SELECT count(*) > 0, bool_and(begin_snapshot = getvariable('rewrite_snapshot')) FROM rewrite_meta.ducklake_data_file WHERE end_snapshot IS NULL
----
true	true

query II
SELECT count(*), bool_and(end_snapshot = getvariable('rewrite_snapshot')) FROM rewrite_meta.ducklake_delete_file
----
8	true

query II
SELECT count(*), sum(id) FROM dl.a AT (VERSION => getvariable('before_delete'))
----
400	79800

query II
SELECT count(*), sum(id) FROM dl.b AT (VERSION => getvariable('before_delete'))
----
400	79800
