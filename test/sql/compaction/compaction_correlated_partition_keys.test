# name: test/sql/compaction/compaction_correlated_partition_keys.test
# description: Compaction keeps correlated, swapped and null partition groups distinct
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/compaction_correlated_partition_keys', METADATA_CATALOG 'compaction_meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
SET threads = 1

statement ok
CREATE TABLE dl.t(a BIGINT, b BIGINT, payload BIGINT)

statement ok
ALTER TABLE dl.t SET PARTITIONED BY (a, b)

loop batch 0 2

statement ok
INSERT INTO dl.t VALUES (1, 1, {batch}), (2, 2, {batch}), (1, 2, {batch}), (2, 1, {batch}), (NULL, NULL, {batch}), (NULL, 1, {batch}), (1, NULL, {batch})

endloop

query I
SELECT count(*) FROM compaction_meta.ducklake_data_file WHERE end_snapshot IS NULL
----
14

statement ok
CALL ducklake_merge_adjacent_files('dl', 't')

query I
SELECT count(*) FROM compaction_meta.ducklake_data_file WHERE end_snapshot IS NULL
----
7

query IIII rowsort
SELECT a, b, count(*), sum(payload) FROM dl.t GROUP BY a, b
----
1	1	2	1
1	2	2	1
1	NULL	2	1
2	1	2	1
2	2	2	1
NULL	1	2	1
NULL	NULL	2	1
