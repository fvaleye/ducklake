# name: benchmark/micro/read/scan_puffin_history.benchmark
# description: Run 10 selective reads of a file whose Puffin deletion vector holds two cumulative snapshots
# group: [read]

name Scan Puffin History
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/puffin_history.benchmark.in

run
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;
SELECT sum(id) FROM lake.t WHERE id >= 1999000;

result_query I
SELECT * FROM __answer
----
1997499501
