# name: benchmark/micro/read/snapshots_listing_count.benchmark
# description: Count 100001 DuckLake snapshots without requesting their output columns
# group: [read]

name Snapshots Listing Count
group micro
subgroup read

require ducklake

include benchmark/micro/fixtures/snap100k.benchmark.in

run
SELECT count(*) FROM ducklake_snapshots('lake');

result_query I
SELECT * FROM __answer
----
100001
